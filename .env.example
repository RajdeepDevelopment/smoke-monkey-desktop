# ── Top level ──────────────────────────────────────────────────────────────
COMPOSE_PROJECT_NAME=smoke-monkey
RAG_ENV=development

# ── Postgres ───────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag_secret
POSTGRES_DB=ragdb

# ── Redis ──────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ── NATS ───────────────────────────────────────────────────────────────────
NATS_URL=nats://nats:4222
NATS_JETSTREAM=true

# ── MinIO (S3) ─────────────────────────────────────────────────────────────
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=ragminio
MINIO_SECRET_KEY=ragminio_secret
MINIO_BUCKET=documents
MINIO_SECURE=false

# ── Ollama ─────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_CHAT_MODEL=qwen3:8b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_EMBED_DIMS=768

# ── Chat LLM provider ───────────────────────────────────────────────────────
# "ollama" (self-hosted) | "openrouter" (cloud) | "nvidia" (cloud NIM) | "gemini".
LLM_PROVIDER=ollama
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_MODELS=gemini-3.5-flash,gemini-3.6-flash,gemini-3.1-flash-lite

# ── OpenRouter (cloud) ──────────────────────────────────────────────────────
# Server-level default key (free tier works for the NVIDIA :free models).
# Users can also save their own key in the web UI (Settings) — it is
# encrypted in Postgres (API_KEY_ENCRYPTION_SECRET) and cached in Redis so
# rag-service / document-worker can look it up quickly without hitting the DB.
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=nvidia/nemotron-3-nano-30b-a3b:free
# Comma-separated list shown in the chat model dropdown (~50 most-used models:
# Gemini, Claude, GPT, Grok, DeepSeek, Qwen, Llama, ...). The full 400+ live
# list is also served dynamically from /api/v1/openrouter/models.
OPENROUTER_CHAT_MODELS=google/gemini-3.7-flash,google/gemini-3.6-flash,google/gemini-3.5-flash,google/gemini-3.5-flash-lite,anthropic/claude-opus-5,anthropic/claude-opus-5-fast,anthropic/claude-sonnet-5,anthropic/claude-fable-5,anthropic/claude-opus-4.8,openai/gpt-5.6-luna-pro,openai/gpt-5.6-luna,openai/gpt-5.6-terra,openai/gpt-5.6-sol,openai/gpt-chat-latest,x-ai/grok-4.6,x-ai/grok-4.5,x-ai/grok-4.3,deepseek/deepseek-v4-pro,deepseek/deepseek-v4-flash,deepseek/deepseek-v3.2,deepseek/deepseek-r1,qwen/qwen3.8-max,qwen/qwen3.7-flash,qwen/qwen3.6-35b-a3b,qwen/qwen3.5-9b,meta-llama/llama-4-maverick,meta-llama/llama-4-scout,meta-llama/llama-3.3-70b-instruct,mistralai/mistral-large-2512,mistralai/mistral-small-3.2-24b-instruct,mistralai/codestral-2508,moonshotai/kimi-k3,moonshotai/kimi-k2.6,moonshotai/kimi-k2.5,z-ai/glm-5.2,z-ai/glm-4.7-flash,nvidia/nemotron-3-ultra-550b-a55b,nvidia/nemotron-3-super-120b-a12b:free,nvidia/nemotron-3-nano-30b-a3b:free,nvidia/nemotron-3.5-lightning:free,cohere/command-a,amazon/nova-pro-v1,amazon/nova-2-lite-v1,minimax/minimax-m3,perplexity/sonar-pro,bytedance-seed/seed-2-1-turbo,openrouter/auto,openrouter/fusion,qwen/qwen3.8-2.4t-a95b,z-ai/glm-5v-turbo

# ── NVIDIA NIM (cloud) ──────────────────────────────────────────────────────
# Server-level default key (nvapi-…). Users can also save their own NVIDIA key
# in Settings — used for chat, embeddings and reranking when selected.
NVIDIA_API_KEY=
NVIDIA_CHAT_MODEL=nvidia/nemotron-3-nano-30b-a3b
NVIDIA_CHAT_MODELS=nvidia/nemotron-3-nano-30b-a3b,nvidia/nemotron-3-super-120b-a12b,nvidia/nemotron-3-ultra-550b-a55b,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
NVIDIA_EMBED_MODEL=nvidia/nemotron-3-embed-1b
NVIDIA_EMBED_DIMS=2048
# Swap the rerank layer to NVIDIA NIM (needs NVIDIA_API_KEY):
#   NVIDIA_RERANK_ENABLED=true  (and set OPENROUTER_RERANK_ENABLED=false)
NVIDIA_RERANK_ENABLED=false
NVIDIA_RERANK_MODEL=nvidia/llama-nemotron-rerank-1b-v2

# ── Embedding layer ─────────────────────────────────────────────────────────
# "openrouter" (cloud) | "nvidia" (cloud NIM) or "ollama" (local, nomic-embed-text).
# IMPORTANT: the embedding model is server-global — the pgvector column is
# fixed-dimension. Switching model/dims requires `chunks` reindexing.
EMBED_PROVIDER=openrouter
OPENROUTER_EMBED_MODEL=nvidia/nemotron-3-embed-1b:free
OPENROUTER_EMBED_DIMS=2048

# ── Rerank layer (OpenRouter cross-encoder, free NVIDIA model) ──────────────
OPENROUTER_RERANK_ENABLED=true
OPENROUTER_RERANK_MODEL=nvidia/llama-nemotron-rerank-vl-1b-v2:free

# ── Model catalog (dynamic) ─────────────────────────────────────────────────
# Recommended model presets + provider labels live in a plain-JSON data file:
#   apps/rag-service/src/config/model_catalog.json
# Edit it (or point MODEL_CATALOG_PATH at your own file) to change what the
# Settings page recommends without touching any code.
# MODEL_CATALOG_PATH=

# ── User API key security ───────────────────────────────────────────────────
# 64-char hex secret used to AES-256-GCM encrypt user provider keys at rest.
# Rotate carefully — existing stored keys become undecryptable if changed.
API_KEY_ENCRYPTION_SECRET=change-me-32-bytes-random-hex-0123456789abcdef
# How long resolved keys stay cached in Redis (seconds).
USER_API_KEY_CACHE_TTL=86400

# ── RAG service ────────────────────────────────────────────────────────────
RAG_SERVICE_URL=http://rag-service:8000

# ── API gateway ────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
PORT=3000
CORS_ORIGINS=http://localhost:3001

# ── Feature flags ──────────────────────────────────────────────────────────
HYDE_ENABLED=true
MULTI_QUERY_ENABLED=true
RERANK_ENABLED=false
CACHE_ENABLED=true
QUERY_CACHE_TTL=300
OCR_ENABLED=false
TOP_K=12
CHUNK_SIZE=800
CHUNK_OVERLAP=80

# ── Agentic query routing ──────────────────────────────────────────────────
# Every message is classified by the LLM: general questions skip RAG,
# personal questions hit super memory, document questions run vector RAG.
ROUTER_ENABLED=true
ROUTER_CACHE_TTL=300

# ── Super memory ───────────────────────────────────────────────────────────
# Embeds every chat exchange into pgvector (conversation memory) and extracts
# durable user facts (preferences/projects) for a long-term user profile.
MEMORY_ENABLED=true
MEMORY_TOP_K=5
MEMORY_MIN_SCORE=0.12
MEMORY_EXTRACT_ENABLED=true
# Only facts scored at least this importance (0.0–1.0) are stored.
MEMORY_EXTRACT_MIN_IMPORTANCE=0.5

# ── Live web context (optional) ────────────────────────────────────────────
# DuckDuckGo Instant Answer API — no key needed. Off by default.
WEB_SEARCH_ENABLED=false
WEB_SEARCH_TOP_K=5

# Server defaults for the keyed providers (a user's own saved key always wins).
# The more keys you configure, the more providers contribute to each search.
TAVILY_API_KEY=
# "basic" = 1 Tavily credit/search, "advanced" = 2 credits/search.
TAVILY_SEARCH_DEPTH=basic
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=
BRAVE_API_KEY=
BING_API_KEY=

# When true (default), web search only runs for accounts that flipped the
# Settings → Web search toggle. Set false to let the server-enabled feature
# apply to every user without a per-account opt-in.
WEB_SEARCH_REQUIRE_OPTIN=true
