POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag_secret
POSTGRES_DB=ragdb

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

NATS_URL=nats://localhost:4222

MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=ragminio
MINIO_SECRET_KEY=ragminio_secret
MINIO_BUCKET=documents
MINIO_SECURE=false

RAG_SERVICE_URL=http://localhost:8000

JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
PORT=3000
CORS_ORIGINS=http://localhost:3001
MAX_UPLOAD_MB=10

# Server default keys + user key encryption
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
GEMINI_API_KEY=
OPENCODE_API_KEY=
# Hugging Face token (also settable per user via Settings → Hugging Face)
HUGGING_FACE_TOKEN=
OPENROUTER_CHAT_MODEL=nvidia/nemotron-3-nano-30b-a3b:free
API_KEY_ENCRYPTION_SECRET=change-me-32-bytes-random-hex-0123456789abcdef
USER_API_KEY_CACHE_TTL=86400

# Free OmniRoute gateway (local OpenAI-compatible proxy). When enabled users
# get an OmniRoute toggle in Settings (free/keyless chat mode) and automatic
# fallback when their primary provider's key/token runs out.
OMNIROUTE_ENABLED=false

# Agent context activation strategy (default false).
# When FALSE (default): NO auto-activation — the agent alone decides which
# sub-contexts (and the MCP memory server) are active via context_manage.
# When TRUE: re-enables the old behavior — sub-contexts auto-open at run start
# from task→regex matching, and the MCP memory server activates on every run.
AUTO_CONTEXT_ACTIVATION=false

# Sub-context panel injection (default true). When FALSE the per-call SUB-CONTEXT
# PANEL and the prompt-top sub-context activation statements are NOT injected into
# the system message — the agent then relies purely on MCP activation
# (context_manage for mcp_<id>) and the static system prompt.
SUB_CONTEXT_PANEL_ENABLED=false
