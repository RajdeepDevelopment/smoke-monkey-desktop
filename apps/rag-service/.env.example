POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag_secret
POSTGRES_DB=ragdb

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3:8b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_EMBED_DIMS=768

# Chat LLM provider: "ollama" | "openrouter" | "nvidia" | "gemini"
LLM_PROVIDER=ollama

# OpenRouter (cloud)
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=nvidia/nemotron-3-nano-30b-a3b:free
# ~50 most-used models (Gemini, Claude, GPT, Grok, DeepSeek, Qwen, Llama, ...).
# The full 400+ live list is also served dynamically from /api/v1/openrouter/models.
OPENROUTER_CHAT_MODELS=google/gemini-3.7-flash,google/gemini-3.6-flash,google/gemini-3.5-flash,google/gemini-3.5-flash-lite,anthropic/claude-opus-5,anthropic/claude-opus-5-fast,anthropic/claude-sonnet-5,anthropic/claude-fable-5,anthropic/claude-opus-4.8,openai/gpt-5.6-luna-pro,openai/gpt-5.6-luna,openai/gpt-5.6-terra,openai/gpt-5.6-sol,openai/gpt-chat-latest,x-ai/grok-4.6,x-ai/grok-4.5,x-ai/grok-4.3,deepseek/deepseek-v4-pro,deepseek/deepseek-v4-flash,deepseek/deepseek-v3.2,deepseek/deepseek-r1,qwen/qwen3.8-max,qwen/qwen3.7-flash,qwen/qwen3.6-35b-a3b,qwen/qwen3.5-9b,meta-llama/llama-4-maverick,meta-llama/llama-4-scout,meta-llama/llama-3.3-70b-instruct,mistralai/mistral-large-2512,mistralai/mistral-small-3.2-24b-instruct,mistralai/codestral-2508,moonshotai/kimi-k3,moonshotai/kimi-k2.6,moonshotai/kimi-k2.5,z-ai/glm-5.2,z-ai/glm-4.7-flash,nvidia/nemotron-3-ultra-550b-a55b,nvidia/nemotron-3-super-120b-a12b:free,nvidia/nemotron-3-nano-30b-a3b:free,nvidia/nemotron-3.5-lightning:free,cohere/command-a,amazon/nova-pro-v1,amazon/nova-2-lite-v1,minimax/minimax-m3,perplexity/sonar-pro,bytedance-seed/seed-2-1-turbo,openrouter/auto,openrouter/fusion,qwen/qwen3.8-2.4t-a95b,z-ai/glm-5v-turbo

# NVIDIA NIM (cloud)
NVIDIA_API_KEY=
NVIDIA_CHAT_MODEL=nvidia/nemotron-3-nano-30b-a3b
NVIDIA_CHAT_MODELS=nvidia/nemotron-3-nano-30b-a3b,nvidia/nemotron-3-super-120b-a12b,nvidia/nemotron-3-ultra-550b-a55b,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
NVIDIA_EMBED_MODEL=nvidia/nemotron-3-embed-1b
NVIDIA_EMBED_DIMS=2048
NVIDIA_RERANK_ENABLED=false
NVIDIA_RERANK_MODEL=nvidia/llama-nemotron-rerank-1b-v2

# OmniRoute (free, keyless) — local OpenAI-compatible gateway. When enabled,
# users can toggle it on in Settings to chat with free models (smart "auto"
# routing) without any key, and it becomes the automatic fallback when the
# primary provider's key/token is exhausted. The API key is a dummy value the
# gateway accepts; free/keyless models need no real credentials.
OMNIROUTE_ENABLED=false
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=omniroute
OMNIROUTE_CHAT_MODEL=auto
OMNIROUTE_CHAT_MODELS=auto,auto/best-free,groq/llama-3.3-70b,lc/LongCat-Flash-Lite

EMBED_PROVIDER=openrouter
OPENROUTER_EMBED_MODEL=nvidia/nemotron-3-embed-1b:free
OPENROUTER_EMBED_DIMS=2048
OPENROUTER_RERANK_ENABLED=true
OPENROUTER_RERANK_MODEL=nvidia/llama-nemotron-rerank-vl-1b-v2:free

GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-3.5-flash
GEMINI_MODELS=gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite

# OpenAI (ChatGPT) — server-level default key; users can also bring their own.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-chat-latest
OPENAI_CHAT_MODELS=gpt-5.6-luna-pro,gpt-5.6-luna,gpt-5.6-terra,gpt-5.6-sol,gpt-chat-latest,gpt-4.1,gpt-4o-mini

# xAI (Grok) — server-level default key; users can also bring their own.
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_CHAT_MODEL=grok-4.6
XAI_CHAT_MODELS=grok-4.6,grok-4.5,grok-4.3

# OpenCode Zen (opencode.ai) — free OpenCode Zen models. Server-level default
# key; users can also bring their own.
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/v1
OPENCODE_CHAT_MODEL=deepseek-v4-flash-free
OPENCODE_CHAT_MODELS=deepseek-v4-flash-free,nemotron-3-ultra-free,mimo-v2.5-free,laguna-s-2.1-free,big-pickle

HYDE_ENABLED=true
MULTI_QUERY_ENABLED=true
RERANK_ENABLED=false
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
CACHE_ENABLED=true
QUERY_CACHE_TTL=300
TOP_K=12
RERANK_TOP_N=8
CONTEXT_TOKEN_BUDGET=6000
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
HALLUCINATION_CHECK_ENABLED=false

# Agentic query routing + super memory (see root .env.example)
ROUTER_ENABLED=true
ROUTER_CACHE_TTL=300
MEMORY_ENABLED=true
MEMORY_TOP_K=5
MEMORY_MIN_SCORE=0.12
MEMORY_EXTRACT_ENABLED=true
# Only facts scored at least this importance (0.0-1.0) are stored.
MEMORY_EXTRACT_MIN_IMPORTANCE=0.5

# Transactional outbox (cross-store consistency): durable memory writes are
# replayed into Neo4j with retry + exponential backoff, then a DLQ table.
MEMORY_OUTBOX_ENABLED=true
MEMORY_OUTBOX_BATCH_SIZE=50
MEMORY_OUTBOX_POLL_INTERVAL_S=1.0
MEMORY_OUTBOX_CLAIM_SECONDS=60
MEMORY_OUTBOX_MAX_ATTEMPTS=5
MEMORY_OUTBOX_BACKOFF_BASE_S=1.0
MEMORY_OUTBOX_BACKOFF_MAX_S=300.0

# Scheduler: SKIP LOCKED claiming + exactly-once dispatch + per-user fairness.
SCHEDULER_ENABLED=true
SCHEDULER_POLL_INTERVAL_S=2.0
SCHEDULER_CLAIM_BATCH=100
SCHEDULER_CLAIM_SECONDS=120
SCHEDULER_MAX_PER_USER_PER_CYCLE=10
SCHEDULER_BACKGROUND_MAX_PER_USER_PER_MINUTE=60
# Missed-intent policy on scheduler restart:
#   dispatch_late — dispatch if within the grace window, else expire (default)
#   expire        — never dispatch a missed intent
#   reschedule    — push missed intents to the next retry window
#   alert         — dead-letter missed intents for inspection
SCHEDULER_MISSED_POLICY=dispatch_late
SCHEDULER_MISSED_DISPATCH_MAX_HOURS=24
# Enqueue retry + DLQ: attempts escalate with exponential backoff; past
# SCHEDULER_MAX_ATTEMPTS the intent moves to the intent_dlq table.
SCHEDULER_MAX_ATTEMPTS=5
SCHEDULER_BACKOFF_BASE_S=1.0
SCHEDULER_BACKOFF_MAX_S=300.0

# Memory lifecycle: candidates corroborate into confirmed → stable via recall;
# unused confirmed memories age to stale, and forget becomes a soft archive.
MEMORY_LIFECYCLE_ENABLED=true
MEMORY_CONFIRM_ACCESSES=2
MEMORY_STABLE_ACCESSES=4
MEMORY_STABLE_MIN_IMPORTANCE=0.6
MEMORY_STALE_DAYS=45
MEMORY_EVIDENCE_BOOST=0.02
MEMORY_CONFIDENCE_FLOOR=0.5

# Relationship graph limits: traversal depth, per-query node cap, and a hard
# per-query timeout protect Neo4j from pathological hubs.
MEMORY_GRAPH_MAX_DEPTH=3
MEMORY_GRAPH_MAX_NODES=50
MEMORY_GRAPH_QUERY_TIMEOUT_S=2.0

# Observability: in-process metrics (scheduler cycles, outbox, queue lag,
# memory growth) exposed under /metrics; the sampler loop + tracing hooks are
# gated by MONITOR_ENABLED.
MONITOR_ENABLED=true
MONITOR_POLL_INTERVAL_S=30.0
MONITOR_TRACING_ENABLED=false
MONITOR_QUEUE_MAX_LAG=1000
MONITOR_MEMORY_MAX_ROWS=1000000

# Context router budgets: only call the providers a query needs, and cap how
# many tokens ContextSnapshot may inject (len/4 estimate).
CONTEXT_ROUTER_ENABLED=true
CONTEXT_MAX_TOKENS=4500
CONTEXT_BUDGET_RECENT=1000
CONTEXT_BUDGET_FACTS=1500
CONTEXT_BUDGET_GRAPH=800
CONTEXT_BUDGET_TASKS=500
CONTEXT_BUDGET_PROSPECTIVE=400
CONTEXT_BUDGET_PERSONALITY=300
CONTEXT_BUDGET_LIVE=300
CONTEXT_COMPRESSION_ENABLED=true

WEB_SEARCH_ENABLED=false
WEB_SEARCH_TOP_K=5
# Multi-provider live search: user keys always win over these server defaults.
# TAVILY_SEARCH_DEPTH=basic (1 credit) keeps the free tier (~1k searches/mo) alive.
WEB_SEARCH_CACHE_TTL=21600
WEB_SEARCH_PROVIDERS=tavily,google,brave,bing,duckduckgo
TAVILY_API_KEY=
TAVILY_SEARCH_DEPTH=basic
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=
BRAVE_API_KEY=
BING_API_KEY=
