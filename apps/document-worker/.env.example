NATS_URL=nats://localhost:4222
NATS_JETSTREAM=true

MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=ragminio
MINIO_SECRET_KEY=ragminio_secret
MINIO_BUCKET=documents
MINIO_SECURE=false

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag_secret
POSTGRES_DB=ragdb

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_EMBED_DIMS=768

# Embedding provider: "openrouter" (cloud, default) | "nvidia" (cloud) | "ollama" (local)
EMBED_PROVIDER=openrouter
OPENROUTER_EMBED_MODEL=nvidia/nemotron-3-embed-1b:free
OPENROUTER_EMBED_DIMS=2048
# Server default keys; users may override with their own key saved in Settings.
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
NVIDIA_EMBED_MODEL=nvidia/nemotron-3-embed-1b
NVIDIA_EMBED_DIMS=2048

OCR_ENABLED=false
CHUNK_SIZE=800
CHUNK_OVERLAP=80
EMBED_BATCH_SIZE=32
SUMMARY_ENABLED=false
